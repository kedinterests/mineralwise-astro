# Keep this file tiny.
#
# Cloudflare Pages silently stops processing _redirects after roughly 112 rules,
# and it matches literal paths only, so /foo and /foo/ each need their own line.
# The migration's 344-rule file is what broke the site. All content redirects now
# live in functions/_middleware.js, which has no rule limit, normalises the
# trailing slash, and refuses to point at a page that does not exist.
#
# Only add a rule here if it cannot be expressed in the middleware: a 200 rewrite,
# or something that must run before the Functions layer.

# CMS admin — serve index.html directly without a redirect loop
/admin /admin/index.html 200

# Crawler compatibility: some tools request /sitemap.xml by convention.
/sitemap.xml /sitemap-index.xml 301
