---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageShell from '../../../components/PageShell.astro';
import ArticleContent from '../../../components/ArticleContent.astro';
import { getBreadcrumbs } from '../../../data/hierarchy';
import { getGlossaryLetters, type GlossaryLetter } from '../../../data/glossary';
import { GLOSSARY_BASE } from '../../../data/glossary-rules.mjs';

// One page per letter that has terms. A letter with no terms gets no page:
// empty alphabet stubs are part of what got this glossary dropped from the index.
export async function getStaticPaths() {
	const letters = await getGlossaryLetters();
	return letters.map((entry) => ({
		params: { letter: entry.letter },
		props: { entry, letters },
	}));
}

interface Props {
	entry: GlossaryLetter;
	letters: GlossaryLetter[];
}

const { entry, letters } = Astro.props;
const { label, terms } = entry;
const count = terms.length;
const noun = count === 1 ? 'term' : 'terms';
const startsWith = label === '0-9' ? 'a number' : `the letter ${label}`;

// Named after the Squarespace letter pages these replace ("Oil & Gas Glossary - P Terms").
// BaseHead appends " | MineralWise" to the title.
const heading = `Oil and Gas Glossary: ${label} Terms`;
const title = heading;

// Name a few short terms in the description so each letter page reads differently.
// BaseHead trims anything over 160 characters, so use as many examples as fit.
const shortNames = terms.map((t) => t.term).filter((name) => name.length <= 28 && /^[A-Za-z0-9 -]+$/.test(name));
const describe = (names: string[]) => {
	const examples =
		names.length > 1
			? `, including ${names.slice(0, -1).join(', ')} and ${names[names.length - 1]}`
			: names.length === 1
				? `, including ${names[0]}`
				: '';
	return `Definitions of ${count} oil and gas ${noun} that start with ${startsWith}${examples}. From the MineralWise glossary.`;
};
const description =
	count === 1
		? `The MineralWise glossary has one oil and gas term that starts with ${startsWith}: ${terms[0].term}. Read its definition here.`
		: [3, 2, 1].map((n) => describe(shortNames.slice(0, n))).find((text) => text.length <= 160) ??
	`Definitions of ${count} oil and gas ${noun} that start with ${startsWith}, written for mineral and royalty owners. From the MineralWise glossary.`;

const breadcrumbs = [
	...getBreadcrumbs(GLOSSARY_BASE).map((crumb) => ({ label: crumb.label, href: crumb.href ?? GLOSSARY_BASE + '/' })),
	{ label },
];

const pageUrl = new URL(entry.href, Astro.site ?? Astro.url).toString();
const termSetId = `${pageUrl}#termset`;
const schema = {
	'@context': 'https://schema.org',
	'@type': 'DefinedTermSet',
	'@id': termSetId,
	name: heading,
	description,
	url: pageUrl,
	inLanguage: 'en',
	hasDefinedTerm: terms.map((t) => ({
		'@type': 'DefinedTerm',
		'@id': `${pageUrl}#${t.anchor}`,
		name: t.term,
		description: t.definition,
		url: `${pageUrl}#${t.anchor}`,
		inDefinedTermSet: termSetId,
	})),
};
const schemaJson = JSON.stringify(schema).replace(/</g, '\\u003c');
---

<BaseLayout title={title} description={description}>
	<Fragment slot="head">
		<script type="application/ld+json" is:inline set:html={schemaJson} />
	</Fragment>
	<PageShell breadcrumbs={breadcrumbs}>
		<ArticleContent>
			<div class="terms-page">
				<div class="terms-header">
					<h1>{heading}</h1>
					<p class="terms-intro">
						{count === 1
							? `One oil and gas term starts with ${startsWith}. Its definition is below.`
							: `${count} oil and gas terms start with ${startsWith}. Each one is defined below, in alphabetical order.`}
					</p>
				</div>

				<nav class="letter-index" aria-label="Glossary letters">
					{letters.map((other) =>
						other.letter === entry.letter ? (
							<span class="letter-link letter-link-current" aria-current="page">{other.label}</span>
						) : (
							<a href={other.href} class="letter-link">{other.label}</a>
						)
					)}
				</nav>

				<div class="term-list">
					{terms.map((t) => (
						<section class="term-entry">
							<h2 id={t.anchor}>{t.term}</h2>
							<p>{t.definition}</p>
						</section>
					))}
				</div>

				<div class="view-all">
					<a href={GLOSSARY_BASE + '/'} class="view-all-button">View all Oil &amp; Gas Terms</a>
				</div>
			</div>
		</ArticleContent>
	</PageShell>
</BaseLayout>

<style>
	.terms-page {
		background: white;
		border-radius: 15px;
		padding: 2.5rem;
		box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px -1px rgba(0, 0, 0, 0.1);
	}

	.terms-header {
		margin-bottom: 2rem;
		padding-bottom: 1.5rem;
		border-bottom: 2px solid #e2e8f0;
	}

	.terms-header h1 {
		margin: 0 0 0.75rem 0;
		font-size: 2.5rem;
		font-weight: 700;
		line-height: 1.2;
		color: rgb(var(--gray-dark));
	}

	.terms-intro {
		margin: 0;
		font-size: 1.125rem;
		line-height: 1.75rem;
	}

	.letter-index {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		justify-content: center;
		padding: 1.5rem;
		background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
		border-radius: 12px;
		margin-bottom: 2.5rem;
		border: 1px solid #bae6fd;
	}

	.letter-link {
		display: flex;
		align-items: center;
		justify-content: center;
		min-width: 2.75rem;
		height: 2.75rem;
		padding: 0 0.5rem;
		font-size: 1.125rem;
		font-weight: 700;
		color: #0ea5e9;
		background: white;
		border-radius: 8px;
		text-decoration: none;
		transition: all 0.2s;
		border: 2px solid #0ea5e9;
		box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
	}

	a.letter-link:hover {
		background: #0ea5e9;
		color: white;
		transform: translateY(-2px);
	}

	.letter-link-current {
		background: #0ea5e9;
		color: white;
	}

	.term-entry {
		padding: 1.5rem 0;
		border-bottom: 1px solid #e5e7eb;
	}

	.term-entry:first-child {
		padding-top: 0;
	}

	.term-entry h2 {
		margin: 0 0 0.5rem 0;
		font-size: 1.5rem;
		font-weight: 600;
		line-height: 1.3;
		color: rgb(var(--gray-dark));
		scroll-margin-top: 6rem;
	}

	.term-entry h2:target {
		color: #0284c7;
	}

	.term-entry p {
		margin: 0;
		font-size: 1.125rem;
		line-height: 1.75rem;
	}

	.view-all {
		text-align: center;
		padding-top: 2rem;
	}

	.view-all-button {
		display: inline-block;
		padding: 0.625rem 1.5rem;
		background-color: #0ea5e9;
		color: white;
		text-decoration: none;
		font-weight: 500;
		border-radius: 0.5rem;
		transition: background-color 0.2s;
	}

	.view-all-button:hover {
		background-color: #0284c7;
		text-decoration: none;
	}

	@media (max-width: 768px) {
		.terms-page {
			padding: 1.5rem;
		}

		.terms-header h1 {
			font-size: 2rem;
		}

		.letter-index {
			padding: 1rem;
			gap: 0.375rem;
		}

		.letter-link {
			min-width: 2.5rem;
			height: 2.5rem;
			font-size: 1rem;
		}
	}
</style>
