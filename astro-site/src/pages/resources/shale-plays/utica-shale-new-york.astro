---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageShell from '../../../components/PageShell.astro';
import ArticleContent from '../../../components/ArticleContent.astro';
import ShalePlayPage from '../../../components/ShalePlayPage.astro';
import { getBreadcrumbs } from '../../../data/hierarchy';

const title = "Utica Shale New York | MineralWise";
const description = "The Utica Shale is located in the state of New York. The first production of the Utica Shale occurred in 1934 in Pottawatomie County.";

const shaleName = "Utica Shale";
const state = undefined;
const descriptionText = "The Utica Shale is located in the state of New York. The first production of the Utica Shale occurred in 1934 in Pottawatomie County. Well over 100 wells have been drilled in the Utica Shale in New York. The advent of horizontal drilling and hydraulic fracturing completion technology is now advancing the development of the Utica Shale.";

const companies = [
	"Altai Resources",
	"Equitable Resources",
	"Forest Oil",
	"Gastem",
	"Junex",
	"Questerre Energy",
	"Range Resources",
	"Talisman Energy"
];

const geology = "The Utica Shale is from the Ordivician age. The Utica is a massive, organic rich thermally mature black to greyish shale. The deposition of the Utica Shale followed lithospheric downwarping that is associated with tectonic loading. The shale terminates by shallow shelf carbonates. The Utica Shale composition changes throughout the Appalachian Basin and thickens as it moves eastward across New York";

const counties = [
	"Allegany County NY",
	"Broome County NY",
	"Chemung County NY",
	"Chenango County NY",
	"Cortland County NY",
	"Delaware County NY",
	"Fulton County NY",
	"Herkimer County NY",
	"Madison County NY",
	"Montgomery County NY",
	"Oneida County NY",
	"Otsego County NY",
	"Schohaire County NY",
	"Schuyler County NY",
	"Steuban County NY",
	"Sullivan County NY",
	"Tioga County NY",
	"Tompkins County NY",
	"Ulster County NY"
];

const companiesIntro = "Significant producers within the Utica Shale are:";
const locationIntro = "The Utica Shale is located in the following counties of New York:";

const additionalReading = [
	{
		"text": "Oil & Gas 101",
		"href": "/owners-guide/oil-and-gas-basics-for-mineral-owners/",
		"external": false,
		"note": "General information for mineral rights owners."
	},
	{
		"text": "Utica Shale Ohio",
		"href": "/resources/shale-plays/utica-shale-ohio/",
		"external": false,
		"note": "Short article describing geology, location & counties within the Utica Shale of Ohio. Written for oil and gas mineral rights and royalty owners in NY."
	}
];
---

<BaseLayout title={title} description={description}>
	<PageShell breadcrumbs={getBreadcrumbs('/resources/shale-plays/utica-shale-new-york')}>
		<ArticleContent>
			<ShalePlayPage
				shaleName={shaleName}
				state={state}
				description={descriptionText}
				companies={companies}
				geology={geology}
				counties={counties}
				companiesIntro={companiesIntro}
				locationIntro={locationIntro}
				additionalReading={additionalReading}
			/>
		</ArticleContent>
	</PageShell>
</BaseLayout>
