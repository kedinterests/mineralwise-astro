---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageShell from '../../../components/PageShell.astro';
import ArticleContent from '../../../components/ArticleContent.astro';
import ShalePlayPage from '../../../components/ShalePlayPage.astro';
import { getBreadcrumbs } from '../../../data/hierarchy';

const title = "Woodford Shale Oklahoma | MineralWise";
const description = "The Woodford Shale is located in Oklahoma. The first production of the Woodford Shale occurred in 1934 in Pottawatomie County.";

const shaleName = "Woodford Shale";
const state = undefined;
const descriptionText = "The Woodford Shale is located in Oklahoma. The first production of the Woodford Shale occurred in 1934 in Pottawatomie County. Currently over 130 wells have been drilled in the Woodford Shale. Like in most shale gas plays, Woodford wells were first vertically drilled, then as technology advanced, horizontal wells have become the norm.";

const companies = [
	"Antero Resources",
	"Chesapeake Energy",
	"Cimarex Energy",
	"Continental Resources",
	"Devon Energy",
	"Newfield Exploration",
	"Petroquest Energy",
	"Range Resources",
	"St. Mary Land and Exploration",
	"XTO Energy"
];

const geology = "The Woodford Shale is located in the following geologic basins of Oklahoma: Anadarko Shelf, Arbuckle Uplift, Ardmore Basin, Arkoma Basin, and the Ozark Uplift. The shale is found at depths from 7,500 to 8,500 feet, and is generally 50 to 300 feet thick.";

const counties = [
	"Bryan County OK",
	"Canadian County OK",
	"Carter County OK",
	"Coal County OK",
	"Garvin County OK",
	"Hughes County OK",
	"Johnston County OK",
	"Marshall County OK",
	"Mayes County OK",
	"McIntosh County OK",
	"Pittsburg County OK",
	"Wagoner County OK"
];

const companiesIntro = "Significant producers within the Woodford Shale are:";
const locationIntro = "The Woodford Shale is located in the following counties of Oklahoma:";

const additionalReading = [
	{
		"text": "Oil & Gas 101",
		"href": "/owners-guide/oil-and-gas-basics-for-mineral-owners/",
		"external": false,
		"note": "General information for mineral rights owners."
	}
];
---

<BaseLayout title={title} description={description}>
	<PageShell breadcrumbs={getBreadcrumbs('/resources/shale-plays/woodford-shale-oklahoma')}>
		<ArticleContent>
			<ShalePlayPage
				shaleName={shaleName}
				state={state}
				description={descriptionText}
				companies={companies}
				geology={geology}
				counties={counties}
				companiesIntro={companiesIntro}
				locationIntro={locationIntro}
				additionalReading={additionalReading}
			/>
		</ArticleContent>
	</PageShell>
</BaseLayout>
