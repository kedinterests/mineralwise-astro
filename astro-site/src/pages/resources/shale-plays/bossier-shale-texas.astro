---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageShell from '../../../components/PageShell.astro';
import ArticleContent from '../../../components/ArticleContent.astro';
import ShalePlayPage from '../../../components/ShalePlayPage.astro';
import { getBreadcrumbs } from '../../../data/hierarchy';

const title = "Bossier Shale Texas | MineralWise";
const description = "The Bossier Shale is located in East Texas. The Bossier Shale has a thickness of around 180 ft and is located above the Haynesville Shale.";

const shaleName = "Bossier Shale";
const state = undefined;
const descriptionText = "The Bossier Shale is located in East Texas. The Bossier Shale has a thickness of around 180 ft and is located above the Haynesville Shale. The Bossier Shale is known in the oil and gas industry as one of the \"tight\" sand plays. To date, relatively small amounts of actual well data are available.";

const companies = [
	"Anadarko Petroleum",
	"Berry Petroleum",
	"Cabot Oil and Gas",
	"Chesapeake Energy",
	"Comstock Resources",
	"Cubic Energy",
	"Devon Energy",
	"El Paso Corp.",
	"EnCana Corp.",
	"EOG Resources",
	"EXCO Resources",
	"Forest Oil",
	"GMX Resources",
	"Goodrich Petroleum",
	"Noble Energy",
	"Penn Virginia",
	"Petrohawk",
	"Plains Exploration and Production",
	"Questar Corp.",
	"Shell Western",
	"SM Energy",
	"St. Mary Land & Exploration",
	"XTO Energy"
];

const geology = "The Bossier Shale is an over pressurized geological formation found at depths of 12,000 to 15,000 feet. The productive zone is located in the upper 500 to 600 ft of the shale.";

const counties = [
	"Harrison County TX",
	"Marion County TX",
	"Nacagdoches County TX",
	"Panola County TX",
	"Rusk County TX",
	"Shelby County TX"
];

const companiesIntro = "Significant producers within the Bossier shale are:";
const locationIntro = "The Bossier Shale is located in the following counties of Texas:";

const additionalReading = [
	{
		"text": "Oil & Gas 101",
		"href": "/owners-guide/oil-and-gas-basics-for-mineral-owners/",
		"external": false,
		"note": "General information for mineral rights owners."
	}
];
---

<BaseLayout title={title} description={description}>
	<PageShell breadcrumbs={getBreadcrumbs('/resources/shale-plays/bossier-shale-texas')}>
		<ArticleContent>
			<ShalePlayPage
				shaleName={shaleName}
				state={state}
				description={descriptionText}
				companies={companies}
				geology={geology}
				counties={counties}
				companiesIntro={companiesIntro}
				locationIntro={locationIntro}
				additionalReading={additionalReading}
			/>
		</ArticleContent>
	</PageShell>
</BaseLayout>
