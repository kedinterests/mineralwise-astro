---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageShell from '../../../components/PageShell.astro';
import ArticleContent from '../../../components/ArticleContent.astro';
import ShalePlayPage from '../../../components/ShalePlayPage.astro';
import { getBreadcrumbs } from '../../../data/hierarchy';

const title = "Huron Shale | MineralWise";
const description = "The Huron Shale is located in the Appalachian Basin in West Virginia and Kentucky.";

const shaleName = "Huron Shale";
const state = undefined;
const descriptionText = "The Huron Shale is located in the Appalachian Basin in West Virginia and Kentucky.";

const companies = [
	"EQT Corp.",
	"Equitable Resources",
	"Exco (XCO) Resources",
	"Range Resources."
];

const geology = "The Huron Shale is a geological formation ranging from 200 to 2,000 feet thick and is found at depths of 4,000 to 5,000 feet.";

const counties = [
	"Braxton County WV",
	"Cabell County WV",
	"Calhoun County WV",
	"Clay County WV",
	"Fayette County WV",
	"Jackson County WV",
	"Kanawha County WV",
	"Lincoln County WV",
	"Logan County WV",
	"Mason County WV",
	"Mingo County WV",
	"Nicholas County WV",
	"Pleasants County WV",
	"Putnam County WV",
	"Raleigh County WV",
	"Ritchie County WV",
	"Roane County WV",
	"Tyler County WV",
	"Wayne County WV",
	"Wirt County WV",
	"Wood County WV",
	"Wyoming County WV",
	"Boyd County KY",
	"Floyd County KY",
	"Johnson County KY",
	"Lawrence County KY",
	"Martin County KY",
	"Pike County KY"
];

const companiesIntro = "Significant producers within the Huron Shale are:";
const locationIntro = "The Huron Shale is located in the following counties of West Virginia: The Huron Shale is located in the following counties of Kentucky:";

const additionalReading = [
	{
		"text": "Oil & Gas 101",
		"href": "/owners-guide/oil-and-gas-basics-for-mineral-owners/",
		"external": false,
		"note": "General information for mineral rights owners."
	}
];
---

<BaseLayout title={title} description={description}>
	<PageShell breadcrumbs={getBreadcrumbs('/resources/shale-plays/huron-shale')}>
		<ArticleContent>
			<ShalePlayPage
				shaleName={shaleName}
				state={state}
				description={descriptionText}
				companies={companies}
				geology={geology}
				counties={counties}
				companiesIntro={companiesIntro}
				locationIntro={locationIntro}
				additionalReading={additionalReading}
			/>
		</ArticleContent>
	</PageShell>
</BaseLayout>
