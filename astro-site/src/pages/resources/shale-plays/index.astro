---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageShell from '../../../components/PageShell.astro';
import ArticleContent from '../../../components/ArticleContent.astro';
import { getBreadcrumbs, pageHierarchy } from '../../../data/hierarchy';

const title = "Comprehensive Guide to U.S. Shale Plays: Locations, Resources, and Information";
const description = "Explore a detailed overview of major U.S. shale plays, including Bakken, Eagle Ford, Marcellus, Utica, and more. Learn about their locations, resources, and energy potential across states like Texas, North Dakota, Pennsylvania, and beyond. Stay informed with expert insights.";

// One line summary per play, recovered from the original directory page
const summaries: Record<string, string> = {
	"/resources/shale-plays/bakken-shale-montana": "Short article describing the formation, location & counties of the Bakken Shale in Montana. Written for oil & gas mineral rights and royalty owners in MT.",
	"/resources/shale-plays/bakken-shale-north-dakota": "Short article describing the formation, location & counties of the Bakken Shale in North Dakota. Written for oil & gas mineral rights and royalty owners in ND.",
	"/resources/shale-plays/barnett-shale-texas": "Short article describing the formation, location & counties of the Barnett Shale in Texas. Written for oil & gas mineral rights and royalty owners in TX.",
	"/resources/shale-plays/bossier-shale-texas": "Short article describing the formation, location & counties of the Bossier Shale. Written for oil & gas mineral rights and royalty owners in TX.",
	"/resources/shale-plays/eagle-ford-shale-texas": "Short article describing the formation, location & counties within the Eagle Ford Shale. Written for oil & gas mineral rights and royalty owners in TX.",
	"/resources/shale-plays/fayetteville-shale-arkansas": "Short article describing the formation, location & counties within the Fayetteville Shale of Arkansas. Written for oil & gas mineral rights and royalty owners in AR.",
	"/resources/shale-plays/haynesville-shale-louisiana": "Short article describing the formation, location & counties within the Haynesville Shale of Louisiana. Written for oil & gas mineral rights and royalty owners in LA.",
	"/resources/shale-plays/haynesville-shale-texas": "Short article describing the formation, location & counties in the Haynesville Shale of Texas. Written for oil & gas mineral rights and royalty owners in TX.",
	"/resources/shale-plays/huron-shale": "Short article describing the formation, location & counties in the Huron Shale. Written for oil & gas mineral rights and royalty owners in WV & KY.",
	"/resources/shale-plays/marcellus-shale-maryland": "Short article describing the formation, location & counties in the Marcellus Shale of Maryland. Written for oil & gas mineral rights and royalty owners in MD.",
	"/resources/shale-plays/marcellus-shale-new-jersey": "Short article describing the formation, location & counties in the Marcellus Shale of New Jersey. Written for oil & gas mineral rights and royalty owners in NJ.",
	"/resources/shale-plays/marcellus-shale-new-york": "Short article describing the formation, location & counties in the Marcellus Shale of New York. Written for oil & gas mineral rights and royalty owners in NY.",
	"/resources/shale-plays/marcellus-shale-ohio": "Short article describing the formation, location & counties in the Marcellus Shale of Ohio. Written for oil & gas mineral rights and royalty owners in OH.",
	"/resources/shale-plays/marcellus-shale-pennsylvania": "Short article on the Marcellus Shale of Pennsylvania describing the formation, location & counties. Written for oil & gas mineral rights and royalty owners in PA.",
	"/resources/shale-plays/marcellus-shale-west-virginia": "Short article describing the formation, location & counties in the Marcellus Shale of West Virginia. Written for oil & gas mineral rights and royalty owners in WV.",
	"/resources/shale-plays/niobrara-shale-colorado-and-wyoming": "Short article describing the formation, location & counties of the Niobrara Shale in Colorado and Wyoming. Written for oil & gas mineral rights and royalty owners in CO and WY.",
	"/resources/shale-plays/tuscaloosa-marine-shale-louisiana": "Short article describing the formation, location & counties of the Tuscaloosa Marine Shale in Louisiana. Written for oil & gas mineral rights and royalty owners in LA.",
	"/resources/shale-plays/utica-shale": "Short article describing the formation, location & counties in the Utica Shale. Written for oil & gas mineral rights and royalty owners.",
	"/resources/shale-plays/utica-shale-new-york": "Short article describing the formation, location & counties in the Utica Shale in New York. Written for oil & gas mineral rights and royalty owners.",
	"/resources/shale-plays/utica-shale-ohio": "Short article describing the formation, location & counties in the Utica Shale in Ohio. Written for oil & gas mineral rights and royalty owners.",
	"/resources/shale-plays/woodford-shale-oklahoma": "Short article describing the formation, location & counties in the Woodford Shale. Written for oil & gas mineral rights and royalty owners."
};

const sourcesNote = "Below you'll find articles related to the various natural gas shale plays by state. The articles include information on operators, production, and active counties within the shale plays. Information presented on these Shale Play pages comes from various sources including Operator's public websites, State Oil and Gas Regulatory Bodies, the Energy Information Administration, and proprietary industry knowledge.";

// Get all shale plays from hierarchy
const shalePlays = Object.entries(pageHierarchy)
	.filter(([path, node]) => node.parent === '/resources/shale-plays')
	.map(([path, node]) => ({
		path,
		name: node.label,
		summary: summaries[path.replace(/\/$/, '')] ?? ''
	}));

// Sort alphabetically by name
shalePlays.sort((a, b) => a.name.localeCompare(b.name));
---

<BaseLayout title={title} description={description}>
	<PageShell breadcrumbs={getBreadcrumbs('/resources/shale-plays')}>
		<ArticleContent>
			<div class="shale-plays-page">
				<h1>Shale Plays</h1>
				<p class="intro">Explore our comprehensive directory of major U.S. shale plays, including detailed information about their locations, geology, companies, and energy potential.</p>
				<p class="intro">{sourcesNote}</p>
				
				{shalePlays.length > 0 ? (
					<div class="shale-plays-grid">
						{shalePlays.map((shale) => (
							<a href={shale.path} class="shale-card">
								<div class="shale-name">{shale.name}</div>
								{shale.summary && <p class="shale-summary">{shale.summary}</p>}
							</a>
						))}
					</div>
				) : (
					<p>Loading shale plays...</p>
				)}
			</div>
		</ArticleContent>
	</PageShell>
</BaseLayout>

<style>
	.shale-summary {
		font-size: 0.9375rem;
		font-weight: 400;
		color: #4b5563;
		line-height: 1.55;
		margin: 0.5rem 0 0;
	}

	.shale-plays-page {
		background: white;
		border-radius: 15px;
		padding: 2.5rem;
		box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px -1px rgba(0, 0, 0, 0.1);
	}

	.shale-plays-page h1 {
		font-size: 2.5rem;
		font-weight: 700;
		margin-bottom: 1rem;
		color: #1a1a1a;
	}

	.intro {
		font-size: 1.125rem;
		color: #666;
		margin-bottom: 2.5rem;
		line-height: 1.6;
	}

	.shale-plays-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
		gap: 1rem 1.5rem;
		margin-top: 2rem;
	}

	@media (min-width: 768px) {
		.shale-plays-grid {
			grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
			gap: 1.25rem 2rem;
		}
	}

	@media (min-width: 1024px) {
		.shale-plays-grid {
			grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
			gap: 1.5rem 2.5rem;
		}
	}

	.shale-card {
		display: flex;
		align-items: center;
		justify-content: center;
		text-decoration: none;
		color: inherit;
		padding: 1.25rem 1.75rem;
		border-radius: 12px;
		background: #f9fafb;
		border: 2px solid transparent;
		transition: all 0.3s ease;
		cursor: pointer;
		text-align: center;
		min-height: 65px;
	}

	.shale-card:hover {
		border-color: #0ea5e9;
		background: white;
		transform: translateY(-4px);
		box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
	}

	.shale-name {
		font-size: 1.125rem;
		font-weight: 600;
		color: #1a1a1a;
		line-height: 1.4;
		word-wrap: break-word;
		transition: color 0.3s ease;
	}

	.shale-card:hover .shale-name {
		color: #0ea5e9;
	}

	@media (max-width: 640px) {
		.shale-plays-page {
			padding: 1.5rem;
		}

		.shale-plays-page h1 {
			font-size: 2rem;
		}

		.shale-plays-grid {
			grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
			gap: 0.875rem 1.25rem;
		}

		.shale-card {
			padding: 1rem 1.25rem;
			min-height: 60px;
		}

		.shale-name {
			font-size: 1rem;
		}
	}
</style>
