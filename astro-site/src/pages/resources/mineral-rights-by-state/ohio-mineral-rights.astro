	"Columbia Natural Resources",
	"D&L Energy",
	"East Ohio Gas",
	"Funk Exploration",
	"Ohio Oil",
	"Ramco Oil & Gas",
	"Tri State Production",
	"Viking Resources"
];
const additionalReading = [
	{
		"text": "Oil & Gas 101",
		"href": "/owners-guide/oil-and-gas-basics-for-mineral-owners/",
		"external": false,
		"note": "General information for mineral rights owners. Start here if you’re a newbie."
	},
	{
		"text": "Marcellus Shale Ohio",
		"href": "/resources/shale-plays/marcellus-shale-ohio/",
		"external": false,
		"note": "Short article describing geology, location & counties within the Marcellus Shale of Ohio. Written for oil and gas mineral rights and royalty owners in OH."
	}
